# Example terraform.tfvars for standalone Kafka EC2 module testing
# Copy this to terraform.tfvars and customize for your environment

project     = "data228-project"
environment = "dev"
vpc_id      = "REDACTED"
subnet_ids  = ["REDACTED", "REDACTED", "REDACTED"]

instance_type = "t3.medium"
node_count    = 3
ec2_key_name  = ""  # Optional: provide key pair name for SSH access

allowed_cidr_blocks = ["0.0.0.0/0"]  # Allow all IPs (change for production)

tags = {
  Team        = "big-data-team"
  CostCenter  = "engineering"
  Application = "kafka-cluster"
}

